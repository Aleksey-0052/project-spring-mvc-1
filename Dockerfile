# Упрощенный вариант сборки образа приложения
FROM openjdk:17
ADD target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

# Вариант двухэтапной сборки образа приложения
#build project
# FROM maven:3.9.9-sapmachine-17 AS build
# WORKDIR /app
# COPY pom.xml .
# RUN mvn dependency:go-offline
# COPY src ./src
# RUN mvn clean package -DskipTests

#run project
# FROM openjdk:17
# LABEL authors="Semenikhin A.F."
# WORKDIR /app
# COPY --from=build /app/target/project-spring-mvc-1-1.0-SNAPSHOT.jar spring-mvc.jar
# EXPOSE 8080
# ENTRYPOINT ["java", "-jar", "spring-mvc.jar"]


# FROM maven:3.9.9-sapmachine-17 AS build
# Задаёт базовый образ для этапа сборки — используется официальный образ Maven с предустановленным Java 17 (SapMachine).
# Все последующие команды до следующей FROM будут выполняться в этом образе. Ключевое слово AS build позволяет дать этому
# этапу имя для последующего копирования файлов между этапами.
#
# WORKDIR /app
# Устанавливает рабочую директорию внутри контейнера на /app. Все последующие команды (COPY, RUN и т.д.) будут
# выполняться относительно этой директории.
#
# COPY pom.xml .
# Копирует файл pom.xml (файл конфигурации Maven) из локальной директории в рабочую директорию контейнера (/app).
#
# RUN mvn dependency:go-offline
# Выполняет команду Maven, чтобы заранее загрузить все зависимости проекта в локальный кэш. Это ускоряет последующие
# сборки, так как зависимости уже будут доступны оффлайн.
#
# COPY src ./src
# Копирует директорию src (исходный код Java) из локальной системы в /app/src внутри контейнера.
#
# RUN mvn clean package -DskipTests
# Выполняет сборку Java-проекта с помощью Maven: очищает старые артефакты (clean), собирает проект (package), пропуская
# запуск тестов (ключ -DskipTests). В результате в директории /app/target появится собранный JAR-файл.
#
# FROM openjdk:17
# Начинает второй этап — создание итогового образа для запуска приложения. Используется лёгкий образ с OpenJDK 17.
#
# LABEL authors="Semenikhin A.F."
# Добавляет метаданные к образу — указывает автора образа.
#
# WORKDIR /app
# Снова устанавливает рабочую директорию /app, но уже в новом образе.
#
# COPY --from=build /app/target/project-spring-mvc-1-1.0-SNAPSHOT.jar spring-mvc.jar
# Копирует собранный JAR-файл из первого этапа (build) в текущий образ. В результате в /app появится файл spring-mvc.jar.
#
# COPY resources ./resources
# Копирует директорию resources (вероятно, статические файлы, конфиги и т.д.) из локальной системы в /app/resources
# внутри образа.
#
# EXPOSE 8080
# Объявляет, что контейнер будет слушать порт 8080. Это чисто информационная инструкция для документации — фактическое
# открытие порта происходит при запуске контейнера командой docker run с параметром -p.
#
# ENTRYPOINT ["java", "-jar", "spring-mvc.jar"]
# Определяет команду, которая будет выполняться при запуске контейнера. В данном случае — запуск Java-приложения из файла
# spring-mvc.jar. Используется форма exec (в квадратных скобках), что предпочтительно для корректной передачи сигналов внутри
# контейнера.
#
# Краткая схема работы
# Первый этап (build): В образе Maven копируются и собираются исходники Java-проекта, получается JAR-файл.
# Второй этап (run): В лёгком образе OpenJDK копируется только нужный JAR и ресурсы, при запуске контейнера выполняется
# команда java -jar spring-mvc.jar.
#
# Итог:
# Этот Dockerfile реализует best practice двухэтапной сборки: на первом этапе собирается приложение со всеми
# зависимостями, на втором — создаётся минимальный образ только с необходимыми для запуска файлами. Такой подход
# уменьшает итоговый размер образа и повышает безопасность, так как сборочные инструменты и исходники не попадают в
# финальный образ.



